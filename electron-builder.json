{
  "appId": "com.mini-spotify.app",
  "productName": "Mini Spotify",
  "directories": {
    "output": "dist"
  },
  "files": [
    "dist/**/*",
    "electron/**/*.js",
    "electron/**/*.d.ts"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.ico",
    "sign": false,
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}